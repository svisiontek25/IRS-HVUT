# -------------------------------------------------------------
# TaxBandits Form 2290 IRS E-File API Configuration
# -------------------------------------------------------------
# Obtain these from https://developer.taxbandits.com/

# TaxBandits API Environment: "sandbox" or "production"
TAXBANDITS_ENVIRONMENT=sandbox

# API Client Credentials (from TaxBandits Developer Console)
TAXBANDITS_CLIENT_ID=your_taxbandits_client_id_here
TAXBANDITS_CLIENT_SECRET=your_taxbandits_client_secret_here

# User Token (Generated in TaxBandits Console)
TAXBANDITS_USER_TOKEN=your_taxbandits_user_token_here

# Webhook Secret / Verification (Optional for signature checking)
TAXBANDITS_WEBHOOK_SECRET=your_optional_webhook_secret

# Application Public URL (used for webhooks and callback URLs)
NEXT_PUBLIC_APP_URL=http://localhost:3000

# -------------------------------------------------------------
# Stripe Payment Gateway Configuration (Platform Service Fees)
# -------------------------------------------------------------
# Obtain from https://dashboard.stripe.com/apikeys
STRIPE_SECRET_KEY=sk_test_your_stripe_secret_key_here
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_your_stripe_publishable_key_here
STRIPE_WEBHOOK_SECRET=whsec_your_stripe_webhook_secret_here
